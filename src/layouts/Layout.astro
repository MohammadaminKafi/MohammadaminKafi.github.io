---
import SiteHeader from "../components/SiteHeader";
import { content } from "../content/data";
import "../styles/global.css";
import "../styles/worlds.css";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = "Mohammadamin Kafi — AI & Computer Engineer",
  description = "Mohammadamin Kafi's resume: AI engineering, intelligent systems, embedded computing, projects, teaching, and academic work.",
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(content.personal.photo, Astro.site);
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: content.personal.name,
  url: Astro.site?.toString(),
  image: socialImage.toString(),
  jobTitle: "AI Engineer",
  sameAs: [content.personal.github, content.personal.linkedin],
};
---

<!doctype html>
<html lang="en" data-theme="light" data-mode="balanced" data-world="garden">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4ead3" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const validModes = ["balanced", "job", "academic"];
          const params = new URLSearchParams(location.search);
          const requested = params.get("mode");
          const storedMode = localStorage.getItem("resume-mode");
          const mode = validModes.includes(requested)
            ? requested
            : validModes.includes(storedMode)
              ? storedMode
              : "balanced";
          const atmospheres = {
            balanced: {
              theme: "light",
              world: "garden",
              themeColor: "#f4ead3",
            },
            job: {
              theme: "dark",
              world: "cathedral",
              themeColor: "#090711",
            },
            academic: {
              theme: "dark",
              world: "tomorrow",
              themeColor: "#070611",
            },
          };
          const atmosphere = atmospheres[mode];
          document.documentElement.dataset.mode = mode;
          document.documentElement.dataset.theme = atmosphere.theme;
          document.documentElement.dataset.world = atmosphere.world;
          document.documentElement.classList.toggle(
            "dark",
            atmosphere.theme === "dark",
          );
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", atmosphere.themeColor);
        } catch {
          document.documentElement.dataset.mode = "balanced";
          document.documentElement.dataset.theme = "light";
          document.documentElement.dataset.world = "garden";
        }
      })();
    </script>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="world-canvas" aria-hidden="true">
      <div class="world-art world-art-garden">
        <div class="garden-vault"></div>
        <div class="garden-axis"></div>
        <div class="garden-rosette garden-rosette-one"></div>
        <div class="garden-rosette garden-rosette-two"></div>
      </div>
      <div class="world-art world-art-cathedral">
        <div class="cathedral-window"></div>
        <div class="cathedral-piers"></div>
        <div class="cathedral-light cathedral-light-one"></div>
        <div class="cathedral-light cathedral-light-two"></div>
      </div>
      <div class="world-art world-art-tomorrow">
        <div class="tomorrow-orbit"></div>
        <div class="tomorrow-grid"></div>
        <div class="tomorrow-scan"></div>
      </div>
    </div>
    <div class="scene-transition" aria-hidden="true">
      <div class="transition-world transition-garden">
        <span></span><span></span><span></span>
      </div>
      <div class="transition-world transition-cathedral">
        <span></span><span></span>
      </div>
      <div class="transition-world transition-tomorrow">
        <span></span><span></span><span></span>
      </div>
    </div>
    <p id="mode-announcer" class="sr-only" aria-live="polite"></p>
    <SiteHeader
      client:load
      modes={content.modes}
      pages={content.pages}
      currentPath={Astro.url.pathname}
    />
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Mohammadamin Kafi</span>
      <span>Built as a static, accessible Astro site.</span>
    </footer>
    <script is:inline>
      (() => {
        const syncModeLinks = () => {
          const mode = document.documentElement.dataset.mode || "balanced";
          document.querySelectorAll("a[data-mode-link]").forEach((anchor) => {
            const original =
              anchor.getAttribute("data-base-href") ||
              anchor.getAttribute("href");
            if (!original) return;
            anchor.setAttribute("data-base-href", original);
            const url = new URL(original, location.origin);
            url.searchParams.set("mode", mode);
            anchor.setAttribute(
              "href",
              `${url.pathname}${url.search}${url.hash}`,
            );
          });
        };
        syncModeLinks();
        window.addEventListener("resume:modechange", syncModeLinks);
      })();
    </script>
  </body>
</html>
