---
import EducationDetail from "../../components/EducationDetail";
import { content } from "../../content/data";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return content.education.map((education) => ({
    params: { slug: education.slug },
    props: { education },
  }));
}

const { education } = Astro.props;
---

<Layout
  title={`${education.header.title} — Mohammadamin Kafi`}
  description={`${education.header.title} at ${education.header.org}: academic context and coursework.`}
>
  <a class="back-link" href="/" data-mode-link>← Back to resume</a>
  <header class="detail-hero">
    <p class="eyebrow">Education</p>
    <h1>{education.header.title}</h1>
    <p class="detail-org">{education.header.org}</p>
    <div class="detail-meta">
      <span>{education.header.period}</span>
      {education.header.degree && <span>{education.header.degree}</span>}
      {education.header.minor && <span>Minor: {education.header.minor}</span>}
      {
        education.header.gpaOverall !== undefined && (
          <span>GPA: {education.header.gpaOverall}/20</span>
        )
      }
    </div>
  </header>
  <EducationDetail client:visible education={education} />
</Layout>
