---
import ExperienceDetail from "../../components/ExperienceDetail";
import { content } from "../../content/data";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return content.experiences.map((experience) => ({
    params: { slug: experience.slug },
    props: { experience },
  }));
}

const { experience } = Astro.props;
---

<Layout
  title={`${experience.header.title} — Mohammadamin Kafi`}
  description={`${experience.header.title} at ${experience.header.company}: responsibilities, outcomes, and skills.`}
>
  <a class="back-link" href="/" data-mode-link>← Back to resume</a>
  <header class="detail-hero">
    <p class="eyebrow">Experience</p>
    <h1>{experience.header.title}</h1>
    <p class="detail-org">{experience.header.company}</p>
    <div class="detail-meta">
      <span>{experience.header.period}</span>
      {experience.header.location && <span>{experience.header.location}</span>}
      {experience.header.type && <span>{experience.header.type}</span>}
    </div>
  </header>
  <ExperienceDetail client:visible experience={experience} />
</Layout>
