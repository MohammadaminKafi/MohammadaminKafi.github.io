---
import { content } from "../content/data";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Gallery — Mohammadamin Kafi"
  description="A visual gallery of generated aurora studies for Mohammadamin Kafi's resume website."
>
  <header class="page-heading">
    <p class="eyebrow">Visual studies</p>
    <h1>Three perspectives, one atmosphere.</h1>
    <p>
      Abstract aurora studies for the Balanced, Job, and Academic modes. These
      are generated decorative works, not documentary photographs.
    </p>
  </header>
  <div class="gallery-grid">
    {
      content.gallery.map((item) => (
        <figure class="gallery-card">
          <img
            src={item.src}
            alt={item.alt}
            width={item.width}
            height={item.height}
            loading="lazy"
          />
          <figcaption>
            <span>{item.caption}</span>
            {item.generated && <small>Generated artwork</small>}
          </figcaption>
        </figure>
      ))
    }
  </div>
</Layout>
